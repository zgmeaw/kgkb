# 本地开发环境配置示例
# 复制此文件为 .env 并填入实际值

# ===== 访问密码配置 =====
# 访问密码的 SHA-256 哈希值
# 生成方法：访问 https://emn178.github.io/online-tools/sha256.html
# 输入您的密码，复制生成的哈希值
VITE_ACCESS_PASSWORD_HASH=your_password_hash_here

# ===== 云端存储配置 =====
# 存储后端类型：github_gist 或 cloudflare_r2
# 推荐使用 r2 以支持大数据集（1000+ 条岗位记录）
# R2: 适合大数据集（1000+ 条记录），无 API 限制，需要 Cloudflare 账号
# Gist: 适合小数据集（<500 条记录），依赖 GitHub，有 API 速率限制
# 如果 R2 配置缺失，系统会自动回退到 Gist 后端
VITE_STORAGE_BACKEND=r2

# ----- GitHub Gist 配置（如果使用 github_gist）-----
# GitHub Token 在登录时输入，无需在此配置

# ----- Cloudflare R2 配置（如果使用 cloudflare_r2）-----
# Cloudflare Worker URL（部署 cloudflare-worker/worker.js 后获得）
VITE_R2_WORKER_URL=https://your-worker.your-subdomain.workers.dev

# R2 API Key（在 Cloudflare Dashboard 中设置为 Secret）
VITE_R2_API_KEY=your-api-key-here

# ===== GitHub 数据管理配置 =====
# GitHub 用户名和仓库名已写死在代码中（zgmeaw/kgkb）
# 用户只需在登录时输入 GitHub Token 即可
# Token 需要 repo 和 workflow 权限
# 获取方法：https://github.com/settings/tokens

# ===== 配置说明 =====
# 1. 密码配置：
#    - 生成 SHA-256 哈希：https://emn178.github.io/online-tools/sha256.html
#    - 例如密码 "123456" 的哈希值：
#      8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92
#
# 2. 存储后端选择：
#    - github_gist: 使用 GitHub Gist（默认，简单）
#    - cloudflare_r2: 使用 Cloudflare R2（推荐，更快更稳定）
#
# 3. GitHub Gist 配置：
#    - Token 在登录页面输入
#    - 需要 gist 权限
#    - 获取方法：https://github.com/settings/tokens
#
# 4. Cloudflare R2 配置：
#    - 需要创建 R2 Bucket
#    - 需要创建 API Token
#    - 详细步骤见 CLOUDFLARE_R2_SETUP.md
#
# 5. GitHub 数据管理配置：
#    - GitHub 用户名和仓库名已写死在代码中（zgmeaw/kgkb）
#    - 用户只需在登录时输入 GitHub Token
#    - Token 需要 repo 和 workflow 权限
#    - 数据文件保存在 user-data/ 目录下
#
# 6. 安全提示：
#    - 不要将 .env 文件提交到 Git
#    - 使用 GitHub Secrets 存储敏感信息
#    - 定期轮换 API Token
